# ─── Server ───
PORT=5000
NODE_ENV=development

# ─── JWT Authentication ───
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_EXPIRES_IN=24h

# ─── CORS Allowed Origins ───
# Comma separation is NOT supported — one origin per variable
CORS_ORIGIN_PUBLIC=http://localhost:5173
CORS_ORIGIN_ADMIN=http://localhost:5174

# ─── Admin Seed Credentials ───
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SensonGrid@2026

# ─── Database ───
# Path to SQLite database file (relative to backend/ directory)
DB_PATH=./senson_grid.db
