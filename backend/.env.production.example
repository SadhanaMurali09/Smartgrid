# ─── Server ───
PORT=5000
NODE_ENV=production

# ─── JWT Authentication ───
# IMPORTANT: Generate a strong secret before deploying!
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-64-char-random-hex>
JWT_EXPIRES_IN=8h

# ─── CORS Allowed Origins ───
CORS_ORIGIN_PUBLIC=https://sensongrid.com
CORS_ORIGIN_ADMIN=https://admin.sensongrid.com

# ─── Admin Seed Credentials ───
# Change these before running the seed script in production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong-production-password>

# ─── Database ───
# Use an absolute path in production for reliability
DB_PATH=./data/senson_grid.db
